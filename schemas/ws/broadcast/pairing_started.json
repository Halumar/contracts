{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "broadcast pairing_started",
  "description": "PIN window opened (never contains the PIN).",
  "x-audience": "ADMIN",
  "type": "object",
  "required": [
    "type",
    "data"
  ],
  "properties": {
    "type": {
      "const": "pairing_started"
    },
    "data": {
      "type": "object",
      "properties": {
        "is_guest": {
          "type": "boolean"
        },
        "expires_in": {
          "type": "integer",
          "const": 300
        }
      },
      "required": [
        "is_guest",
        "expires_in"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
