  "type": "object",
  "required": [
    "type",
    "command",
    "entity_id"
  ],
  "properties": {
    "type": {
      "const": "command"
    },
    "command": {
      "const": "show_entity"
    },
    "entity_id": {
      "type": "string"
    },
    "control_mode": {
      "$ref": "../../common/defs.json#/$defs/control_mode"
    }
  },
  "additionalProperties": true
}
