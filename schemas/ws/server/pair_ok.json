{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pair_ok",
  "description": "Pairing succeeded; the connection is authenticated. The secret is shown exactly once. Carries protocol_version, min_protocol_version and min_app_version like auth_ok.",
  "type": "object",
  "required": [
    "type",
    "client_id",
    "client_name",
    "secret",
    "protocol_version",
    "min_protocol_version",
    "min_app_version"
  ],
  "properties": {
    "type": {
      "const": "pair_ok"
    },
    "client_id": {
      "$ref": "../../common/defs.json#/$defs/uuid"
    },
    "client_name": {
      "type": "string"
    },
    "secret": {
      "allOf": [
        {
          "$ref": "../../common/defs.json#/$defs/secret"
        }
      ],
      "x-sensitive": true
    },
    "is_guest": {
      "const": true
    },
    "expires_at": {
      "$ref": "../../common/defs.json#/$defs/timestamp"
    },
    "protocol_version": {
      "$ref": "../../common/defs.json#/$defs/protocol_version",
      "description": "Protocol version of the hub. An app that cannot speak it (hub too old for the app) shows 'update the hub'."
    },
    "min_protocol_version": {
      "$ref": "../../common/defs.json#/$defs/protocol_version",
      "description": "Lowest client protocol version the hub serves."
    },
    "min_app_version": {
      "$ref": "../../common/defs.json#/$defs/min_app_version"
    }
  },
  "additionalProperties": true,
  "dependentRequired": {
    "is_guest": [
      "expires_at"
    ]
  }
}
