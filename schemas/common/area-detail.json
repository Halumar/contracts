{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Area detail (WebSocket get_area)",
  "description": "Area row plus sections with entities (incl. live state) and widgets, for an area in the client's scope.",
  "allOf": [
    {
      "$ref": "area.json"
    }
  ],
  "type": "object",
  "required": [
    "sections",
    "section_count"
  ],
  "properties": {
    "section_count": {
      "type": "integer",
      "minimum": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "section.json"
      }
    }
  }
}
