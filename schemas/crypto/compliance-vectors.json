{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compliance signature v1 known-answer vectors",
  "description": "k_sign = HMAC_SHA256(key=digest32, msg=label); sig = hexlower(HMAC_SHA256(key=k_sign, msg='v1|'+client_id+'|'+status+'|'+ts)). digest32 = raw SHA-256 of the UTF-8 client secret. Recomputed by tools/validate.py.",
  "type": "object",
  "required": [
    "label",
    "cases"
  ],
  "properties": {
    "label": {
      "const": "hub/compliance/v1",
      "description": "Functional label, independent of brand and namespace."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "client_id",
          "status",
          "ts",
          "k_sign",
          "sig"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "description": "Optional; when present digest32 = sha256(secret)."
          },
          "digest32": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "client_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "need_token_update",
              "deleted"
            ]
          },
          "ts": {
            "type": "integer"
          },
          "k_sign": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sig": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "anyOf": [
          {
            "required": [
              "secret"
            ]
          },
          {
            "required": [
              "digest32"
            ]
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
