{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halumar/contracts/brand.schema.json",
  "title": "Display brand",
  "description": "Single source of truth for everything the user sees as the product brand. Only display data lives here. The technical namespace (domain, Bonjour type, URL scheme) is not part of the brand and must not be derived from this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "short_name", "tagline", "description", "urls", "legal", "apple", "home_assistant", "colors"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "integer", "enum": [1]},
    "name": {
      "description": "Full product name, e.g. shown in app titles and HA device names.",
      "type": "string", "minLength": 1, "maxLength": 30
    },
    "short_name": {
      "description": "Short name for tight spaces (home screen label, tvOS shelf). Apple truncates labels above ~12 characters.",
      "type": "string", "minLength": 1, "maxLength": 12
    },
    "tagline": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {
      "description": "One-line description of the product. The add-on store entry uses home_assistant.addon_description.",
      "type": "string", "minLength": 1, "maxLength": 120
    },
    "placeholders": {
      "description": "Keys whose values are not final yet. brandgen prints a warning for each; --strict fails instead.",
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z_.]+$"}
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["website", "support", "privacy", "source"],
      "properties": {
        "website": {"type": "string", "format": "uri"},
        "support": {"type": "string", "format": "uri"},
        "privacy": {"type": "string", "format": "uri"},
        "source": {"type": "string", "format": "uri"}
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copyright_holder", "copyright_start_year"],
      "properties": {
        "copyright_holder": {"type": "string", "minLength": 1},
        "copyright_start_year": {"type": "integer", "minimum": 2020, "maximum": 2100}
      }
    },
    "apple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": {
          "description": "CFBundleDisplayName via $(BRAND_DISPLAY_NAME).",
          "type": "string", "minLength": 1, "maxLength": 30
        }
      }
    },
    "home_assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addon_name", "addon_description", "panel_title", "integration_name"],
      "properties": {
        "addon_name": {"type": "string", "minLength": 1},
        "addon_description": {"type": "string", "minLength": 1},
        "panel_title": {"type": "string", "minLength": 1, "maxLength": 30},
        "integration_name": {"type": "string", "minLength": 1}
      }
    },
    "colors": {
      "description": "Brand color palette.",
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "background", "surface", "text", "text_secondary", "text_tertiary", "success", "warning", "gradient_sun", "gradient_sea"],
      "properties": {
        "primary": {"$ref": "#/$defs/hex"},
        "accent": {"$ref": "#/$defs/hex"},
        "background": {"$ref": "#/$defs/hex"},
        "surface": {"$ref": "#/$defs/hex"},
        "text": {"$ref": "#/$defs/hex"},
        "text_secondary": {"$ref": "#/$defs/hex"},
        "text_tertiary": {"$ref": "#/$defs/hex"},
        "success": {"$ref": "#/$defs/hex"},
        "warning": {"$ref": "#/$defs/hex"},
        "gradient_sun": {"type": "array", "items": {"$ref": "#/$defs/hex"}, "minItems": 2, "maxItems": 2},
        "gradient_sea": {"type": "array", "items": {"$ref": "#/$defs/hex"}, "minItems": 2, "maxItems": 2}
      }
    }
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}
  }
}
